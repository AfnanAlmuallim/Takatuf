{
  "name": "takatuf-firebase",
  "private": true,
  "description": "Firestore rules, indexes, rules tests and local seed data for Takatuf",
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-takatuf-rules --only firestore \"node --test tests/rules.test.mjs\"",
    "seed": "node seed/seed.mjs",
    "deploy:firestore": "firebase deploy --only firestore",
    "smoke": "node tests/live-smoke.mjs",
    "smoke:cleanup": "node tests/live-smoke-cleanup.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0"
  }
}
