<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Takatuf" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/takatuf_night</item>
    </style>

    <style name="Theme.Takatuf.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/takatuf_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <!-- The mark's navy figure needs a light disc behind it on the dark splash. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/takatuf_paper</item>
        <item name="postSplashScreenTheme">@style/Theme.Takatuf</item>
    </style>
</resources>
