# Settings for the in-app AI role suggestions. Read by Gradle at build time and compiled into
# the app, so anyone with the APK can extract the key: give it a monthly budget cap in the
# OpenAI dashboard and don't publish an APK built with it. Never commit a real key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-luna
# Suggestions each device may request per day (protects the LLM budget).
AI_DAILY_LIMIT=20
